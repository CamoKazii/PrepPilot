# Local-only is the safe default.
VITE_ENABLE_CLOUD_SYNC=false

# Supply these only after applying the Supabase migration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# AI is optional and must call a server-side gateway. Never put a model API key in VITE variables.
VITE_ENABLE_AI=false
VITE_AI_GATEWAY_URL=https://your-secure-gateway.example.com

# Garmin is optional and must use an approved server-side Garmin Connect Developer Program integration.
VITE_ENABLE_GARMIN=false
VITE_GARMIN_GATEWAY_URL=https://your-approved-garmin-gateway.example.com

# Never put a Supabase service-role key, AI provider secret, Garmin client secret or OAuth token in this file or any VITE_ variable.
